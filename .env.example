# ──────────────────────────────────────────────────────────────────────────────
# FMMS Environment Variables — Example
#
# Copy this file to .env and fill in your local values.
# .env is gitignored and must never be committed.
# All variables here are required unless marked [optional].
# ──────────────────────────────────────────────────────────────────────────────

# ── Django Core ───────────────────────────────────────────────────────────────

# Which settings module to load
# Options: config.settings.development | config.settings.staging | config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.development

# Django secret key — generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Debug mode — must be False in production
DEBUG=True

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=DEBUG

# ── Database ──────────────────────────────────────────────────────────────────

# Discrete PostgreSQL credentials — do NOT use DATABASE_URL.
POSTGRES_DB=fmms
POSTGRES_USER=fmms
POSTGRES_PASSWORD=fmms
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_CONNECT_TIMEOUT=5
POSTGRES_STATEMENT_TIMEOUT_MS=30000
POSTGRES_CONN_MAX_AGE=60
# Enable only with psycopg 3 + pool support and a worker/connection budget.
POSTGRES_POOL_ENABLED=False
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=10
POSTGRES_POOL_TIMEOUT=10
# Host visible from Compose containers; override for a remote PostgreSQL server.
POSTGRES_DOCKER_HOST=host.docker.internal

# ── Redis ─────────────────────────────────────────────────────────────────────

# Redis connection URL (used for cache and Celery result backend)
REDIS_URL=redis://localhost:6379/0

# ── Celery ────────────────────────────────────────────────────────────────────

# Celery broker URL (separate Redis DB from cache)
CELERY_BROKER_URL=redis://localhost:6379/1

# Periodic SAP OData vehicle sync interval in hours
VEHICLE_SYNC_INTERVAL_HOURS=24

# ── SAP Integration ───────────────────────────────────────────────────────────
# When SAP_USE_MOCK=True (default for dev/test), all SAP calls use MockSAPClient.
# Set SAP_USE_MOCK=False only when real SAP credentials are available.

# Use mock SAP client (True in dev/test; False requires all credentials below)
SAP_USE_MOCK=True

# Enable outbound SAP writes (BAPI/RFC). Keep False for read-only OData testing.
SAP_WRITE=False

# SAP OData base URL — required when SAP_USE_MOCK=False
# Example: https://sap-host.example.com/sap/opu/odata/sap
SAP_BASE_URL=

# SAP client/mandant number — required when SAP_USE_MOCK=False
# Example: 100
SAP_CLIENT=

# SAP technical user login — required when SAP_USE_MOCK=False
SAP_USERNAME=

# SAP technical user password — required when SAP_USE_MOCK=False
SAP_PASSWORD=

# SAP RFC application server hostname — required for live BAPI writes
SAP_ASHOST=

# SAP system number (for RFC connection) — default: 00
SAP_SYSNR=00

# SAP logon language — default: EN
SAP_LANG=EN

# OData request timeout in seconds — default: 30
SAP_TIMEOUT_SECONDS=30

# Verify SAP HTTPS certificates. Set False only for self-signed/internal certs.
SAP_VERIFY_SSL=True

# Vehicle/driver OData service used for phase-1 vehicle and driver sync.
# Full SAP URL:
# <SAP_BASE_URL>/ZC_VEHICLEDRIVER_CDS/ZC_VehicleDriver?$format=json
SAP_VEHICLE_DRIVER_SERVICE=ZC_VEHICLEDRIVER_CDS
SAP_VEHICLE_DRIVER_ENTITY_SET=ZC_VehicleDriver

# Object-part / inspection checklist catalog OData
# http://ghsapsnd-app.gbgnetwork.net:8000/sap/opu/odata/sap/ZI_FLEET_CAT_B_CDS/?$format=xml
SAP_OBJECT_PART_CATALOG_SERVICE=ZI_FLEET_CAT_B_CDS
SAP_OBJECT_PART_CATALOG_ENTITY_SET=

# Fault / defect catalog OData
# http://ghsapsnd-app.gbgnetwork.net:8000/sap/opu/odata/sap/ZI_B_DEFECTCATALOG9_CDS/?$format=xml
SAP_FAULT_CATALOG_SERVICE=ZI_B_DEFECTCATALOG9_CDS
SAP_FAULT_CATALOG_ENTITY_SET=

# Central spare-parts warehouse stock OData (storage location KH08)
# http://ghsapsnd-app.gbgnetwork.net:8000/sap/opu/odata/sap/ZI_STOCK_KH08_CDS/?$format=xml
SAP_CENTRAL_STOCK_SERVICE=ZI_STOCK_KH08_CDS
SAP_CENTRAL_STOCK_ENTITY_SET=

# Maximum SAP retry attempts before marking transaction as EXHAUSTED
# Default: 3 (configured on SAPTransaction domain entity)
SAP_MAX_RETRIES=3

# SAP HTTP request timeout in seconds
# Default: 30
SAP_REQUEST_TIMEOUT=30

# ── Security ──────────────────────────────────────────────────────────────────

# Comma-separated list of allowed CORS origins [optional in development]
# Development settings enable CORS_ALLOW_ALL_ORIGINS=True for any localhost port.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://localhost:63342
# Required in production when browser clients use cookies/session authentication.
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5500

# Force HTTPS redirect [set True in staging/production]
SECURE_SSL_REDIRECT=False

# Production paths: MEDIA_ROOT must point to a persistent, backed-up mount.
STATIC_ROOT=/app/staticfiles
MEDIA_ROOT=/app/mediafiles

# ── Observability ─────────────────────────────────────────────────────────────

# Sentry DSN for error tracking [optional — leave blank to disable]
SENTRY_DSN=

# ── Email [optional in development] ──────────────────────────────────────────

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@fmms.local
